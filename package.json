{
  "name": "foodcoop.news",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "vite preview",
    "preview": "vite preview",
    "lint": "pnpm lint:check --fix --fix-suggestions",
    "lint:check": "pnpm exec oxlint $(rg --files . --glob '**/*.{js,jsx,ts,tsx,mjs,cjs,svelte}') --config .oxlintrc.json --tsconfig tsconfig.json --type-aware",
    "svelte:check": "pnpm exec svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "knip": "knip",
    "format": "pnpm exec oxfmt .",
    "format:check": "pnpm exec oxfmt . --check",
    "typecheck": "pnpm exec tsgo --noEmit",
    "check": "pnpm lint && pnpm svelte:check && pnpm knip && pnpm format && pnpm typecheck",
    "backfill": "curl -X POST \"$SITE_URL/api/cron/backfill-produce\" -H \"Authorization: Bearer $CRON_SECRET\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.994.0",
    "@aws-sdk/s3-request-presigner": "^3.994.0",
    "@convex-dev/better-auth": "^0.10.10",
    "@dsnp/parquetjs": "^1.8.7",
    "@duckdb/node-api": "1.4.4-r.1",
    "@khmyznikov/pwa-install": "^0.6.3",
    "@mmailaender/convex-better-auth-svelte": "^0.5.0",
    "@vercel/analytics": "^1.6.1",
    "better-auth": "^1.4.9",
    "cheerio": "^1.1.2",
    "convex": "^1.31.6",
    "fuse.js": "^7.1.0",
    "html-entities": "^2.6.0",
    "jsonwebtoken": "^9.0.3",
    "passkit-generator": "^3.5.7",
    "sharp": "^0.34.5",
    "svelte": "^5.51.2",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@sveltejs/adapter-vercel": "^6.3.1",
    "@sveltejs/kit": "^2.52.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/postcss": "^4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/web-push": "^3.6.4",
    "@typescript/native-preview": "7.0.0-dev.20260225.1",
    "knip": "^5.83.1",
    "oxfmt": "^0.31.0",
    "oxlint": "^1.46.0",
    "oxlint-tsgolint": "^0.11.5",
    "postcss": "^8.5.6",
    "svelte-check": "^4.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^7.3.1"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "sharp",
      "unrs-resolver"
    ]
  }
}
