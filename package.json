{
  "name": "foodcoop.news",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "start": "vp preview",
    "preview": "vp preview",
    "lint": "pnpm exec vp lint --fix",
    "lint:check": "pnpm exec vp lint",
    "svelte:check": "pnpm exec svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "knip": "knip",
    "format": "pnpm exec oxfmt .",
    "format:check": "pnpm exec oxfmt . --check",
    "typecheck": "pnpm exec tsgo --noEmit",
    "check": "pnpm exec vp check && pnpm svelte:check && pnpm knip && pnpm typecheck",
    "backfill": "curl -X POST \"$PUBLIC_SITE_URL/api/cron/backfill-produce\" -H \"Authorization: Bearer $CRON_SECRET\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.994.0",
    "@aws-sdk/s3-request-presigner": "^3.994.0",
    "@convex-dev/better-auth": "^0.10.10",
    "@dsnp/parquetjs": "^1.8.7",
    "@duckdb/node-api": "1.4.4-r.1",
    "@khmyznikov/pwa-install": "^0.6.3",
    "@mmailaender/convex-better-auth-svelte": "^0.5.0",
    "@tanstack/svelte-virtual": "^3.13.19",
    "@vercel/analytics": "^1.6.1",
    "better-auth": "^1.4.9",
    "cheerio": "^1.1.2",
    "convex": "^1.31.6",
    "fuse.js": "^7.1.0",
    "html-entities": "^2.6.0",
    "jsonwebtoken": "^9.0.3",
    "passkit-generator": "^3.5.7",
    "sharp": "^0.34.5",
    "svelte": "^5.51.2",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@sveltejs/adapter-vercel": "^6.3.3",
    "@sveltejs/kit": "^2.55.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.2.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/web-push": "^3.6.4",
    "@typescript/native-preview": "7.0.0-dev.20260225.1",
    "knip": "^5.83.1",
    "svelte-check": "^4.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vite-plus": "latest"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "ignoredBuiltDependencies": [
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "vite": "npm:@voidzero-dev/vite-plus-core@latest",
      "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
    }
  }
}
