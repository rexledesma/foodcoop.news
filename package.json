{
  "name": "foodcoop.news",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "pnpm lint:check --fix --fix-suggestions",
    "lint:check": "pnpm exec oxlint $(rg --files . --glob '**/*.{js,jsx,ts,tsx,mjs,cjs}') --config .oxlintrc.json --tsconfig tsconfig.json",
    "knip": "knip",
    "format": "pnpm exec oxfmt .",
    "format:check": "pnpm exec oxfmt . --check",
    "check": "pnpm lint && pnpm knip && pnpm format && pnpm exec tsc --noEmit",
    "backfill": "curl -X POST \"$SITE_URL/api/cron/backfill-produce\" -H \"Authorization: Bearer $CRON_SECRET\""
  },
  "dependencies": {
    "@convex-dev/better-auth": "^0.10.10",
    "@dsnp/parquetjs": "^1.8.7",
    "@duckdb/duckdb-wasm": "1.33.1-dev18.0",
    "@vercel/analytics": "^1.6.1",
    "@vercel/blob": "^2.0.1",
    "@vercel/speed-insights": "^1.3.1",
    "better-auth": "^1.4.9",
    "cheerio": "^1.1.2",
    "convex": "^1.31.6",
    "fuse.js": "^7.1.0",
    "html-entities": "^2.6.0",
    "jsonwebtoken": "^9.0.3",
    "next": "16.1.1",
    "passkit-generator": "^3.5.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sharp": "^0.34.5",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "knip": "^5.83.1",
    "oxfmt": "^0.31.0",
    "oxlint": "^1.46.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
